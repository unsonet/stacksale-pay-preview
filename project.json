{
  "name": "stacksale-pay-preview",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/stacksale-pay-preview/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}"]
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/stacksale-pay-preview",
        "main": "libs/stacksale-pay-preview/src/index.ts",
        "tsConfig": "libs/stacksale-pay-preview/tsconfig.lib.json",
        "clean": false,
        "assets": [
          "libs/stacksale-pay-preview/*.md",
          "libs/stacksale-pay-preview/example/*"
        ]
      }
    },
    "bundle": {
      "executor": "@nx/webpack:webpack",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/libs/stacksale-pay-preview/bundle"],
      "options": {
        "target": "web",
        "clean": false,
        "outputPath": "dist/libs/stacksale-pay-preview/bundle",
        "main": "libs/stacksale-pay-preview/src/bundle-entry.ts",
        "tsConfig": "libs/stacksale-pay-preview/tsconfig.lib.json",
        "webpackConfig": "libs/stacksale-pay-preview/webpack.config.js"
      }
    },
    "bundle-copy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shx cp -r dist/libs/stacksale-pay-preview/bundle/. dist/libs/stacksale-pay-preview && shx rm -r dist/libs/stacksale-pay-preview/bundle"
      },
      "dependsOn": ["bundle"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/libs/stacksale-pay-preview"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "node scripts/pack.js --input \"./dist/libs/stacksale-pay-preview\""
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build-styles": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sass libs/stacksale-pay-preview/src/styles.scss dist/libs/stacksale-pay-preview/src/styles.css --no-source-map --load-path=node_modules --load-path=libs"
      }
    },
    "build-all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run stacksale-pay-preview:clean",
          "nx run stacksale-pay-preview:build",
          "nx run stacksale-pay-preview:bundle-copy",
          "nx run stacksale-pay-preview:pack"
        ]
      },
      "dependsOn": ["^build"],
      "parallel": false,
      "parallelism": false,
      "cache": false
    }
  }
}
